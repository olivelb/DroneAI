{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "postinstall": "node scripts/patch-playcanvas-fastgs.mjs && node scripts/patch-playcanvas-full-transform.mjs && node scripts/patch-playcanvas-incremental-world.mjs && node scripts/patch-playcanvas-container-intervals.mjs && node scripts/patch-playcanvas-workbuffer-view-direction.mjs",
    "dev": "next dev",
    "build": "node scripts/playcanvas-provenance.mjs && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "duplication": "jscpd ../../shared ../../app1-colmap ../../app2-ia ../../app4-dashboard/api ../../tools --format python --config ../../.jscpd.json"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "playcanvas": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jscpd": "5.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.5",
    "brace-expansion@1": "1.1.18"
  }
}
