{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://droneai.local/schemas/dronegs/trainer-run-v1.schema.json",
  "title": "DroneAI Gaussian trainer run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "backend", "trainer_version", "status",
    "started_at", "finished_at", "dataset", "parameters", "timings",
    "metrics", "artifacts"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "backend": {"type": "string", "minLength": 1},
    "trainer_version": {"type": "string", "minLength": 1},
    "git_revision": {"type": ["string", "null"]},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": {"type": "string"},
        "fingerprint": {"type": "string", "minLength": 1},
        "image_count": {"type": ["integer", "null"], "minimum": 0},
        "source_pixels": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gpu": {"type": ["string", "null"]},
        "driver": {"type": ["string", "null"]},
        "cuda_runtime": {"type": ["string", "null"]},
        "peak_vram_mib": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "iterations", "strategy", "sh_degree", "max_cap",
        "resize_factor", "max_width", "tile_mode", "seed"
      ],
      "properties": {
        "iterations": {"type": "integer", "minimum": 1},
        "strategy": {"type": "string", "minLength": 1},
        "sh_degree": {"type": "integer", "minimum": 0, "maximum": 3},
        "sh_degree_interval": {"type": "integer", "minimum": 1},
        "sh_schedule": {"type": "string"},
        "max_cap": {"type": "integer", "minimum": 1},
        "resize_factor": {"enum": [1, 2, 4, 8]},
        "max_width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "tile_mode": {"enum": [1, 2, 4]},
        "seed": {"type": "integer", "minimum": 0},
        "prefetch_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "decode_workers": {"type": "integer", "minimum": 1, "maximum": 16},
        "jpeg_idct_scale": {"enum": [0, 1]},
        "host_image_storage": {"type": "string"},
        "host_image_cache_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": true,
      "required": ["wall_seconds"],
      "properties": {
        "startup_seconds": {"type": ["number", "null"], "minimum": 0},
        "data_loading_seconds": {"type": ["number", "null"], "minimum": 0},
        "image_decode_seconds": {"type": ["number", "null"], "minimum": 0},
        "image_wait_seconds": {"type": ["number", "null"], "minimum": 0},
        "training_seconds": {"type": ["number", "null"], "minimum": 0},
        "checkpoint_seconds": {"type": ["number", "null"], "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "initial_loss": {"type": ["number", "null"]},
        "final_loss": {"type": ["number", "null"]},
        "image_cache_hits": {"type": ["integer", "null"], "minimum": 0},
        "image_cache_misses": {"type": ["integer", "null"], "minimum": 0},
        "image_cache_evictions": {"type": ["integer", "null"], "minimum": 0},
        "peak_image_cache_bytes": {"type": ["integer", "null"], "minimum": 0},
        "image_prefetch_started": {"type": ["integer", "null"], "minimum": 0},
        "image_prefetch_consumed": {"type": ["integer", "null"], "minimum": 0},
        "image_prefetch_ready": {"type": ["integer", "null"], "minimum": 0},
        "final_gaussians": {"type": ["integer", "null"], "minimum": 0},
        "final_active_sh_degree": {
          "type": ["integer", "null"], "minimum": 0, "maximum": 3
        },
        "gaussians_pruned": {"type": ["integer", "null"], "minimum": 0},
        "gaussian_slots_reused": {
          "type": ["integer", "null"], "minimum": 0
        },
        "topology_compactions": {
          "type": ["integer", "null"], "minimum": 0
        },
        "psnr": {"type": ["number", "null"]},
        "ssim": {"type": ["number", "null"]},
        "lpips": {"type": ["number", "null"]},
        "lpips_network": {"type": "string"},
        "lpips_version": {"type": "string"},
        "lpips_views": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "error": {"type": ["object", "null"], "additionalProperties": true}
  }
}
