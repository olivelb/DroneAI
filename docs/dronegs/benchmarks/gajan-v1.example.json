{
  "schema_version": 1,
  "name": "gajan-v1",
  "repetitions": 5,
  "backends": [
    {
      "name": "lichtfeld",
      "command": [
        "${LICHTFELD_BIN}",
        "--headless", "--train",
        "--data-path", "{data_path}",
        "--output-path", "{output_path}",
        "--iter", "{iterations}",
        "--strategy", "{strategy}",
        "--sh-degree", "{sh_degree}",
        "--max-cap", "{max_cap}",
        "--resize_factor", "{resize_factor}",
        "--max-width", "{max_width}",
        "--tile-mode", "{tile_mode}"
      ],
      "required_artifact_glob": "**/*.ply"
    }
  ],
  "cases": [
    {
      "name": "low-memory",
      "data_path": "${GAJAN_DENSE_PATH}",
      "parameters": {
        "iterations": 5000,
        "strategy": "mrnf",
        "sh_degree": 1,
        "max_cap": 500000,
        "resize_factor": 4,
        "max_width": 1600,
        "tile_mode": 4,
        "seed": 24072026
      }
    }
  ]
}
