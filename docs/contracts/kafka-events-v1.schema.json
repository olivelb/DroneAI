{
  "$defs": {
    "ControlEvent": {
      "additionalProperties": true,
      "properties": {
        "analysis_run_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Run Id"
        },
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "command": {
          "const": "cancel",
          "title": "Command",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "event_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "control",
          "title": "Event Type",
          "type": "string"
        },
        "organization_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "vol_id": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$",
          "title": "Vol Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_type",
        "event_id",
        "correlation_id",
        "attempt",
        "emitted_at",
        "vol_id",
        "command"
      ],
      "title": "ControlEvent",
      "type": "object"
    },
    "DeadLetterEvent": {
      "additionalProperties": true,
      "properties": {
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "attempts": {
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "consumer_group": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Consumer Group",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "error": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Error",
          "type": "string"
        },
        "event_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "dead_letter",
          "title": "Event Type",
          "type": "string"
        },
        "expected_event_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expected Event Type",
          "type": "string"
        },
        "organization_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "original_value": {
          "maxLength": 2000000,
          "title": "Original Value",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_offset": {
          "minimum": 0,
          "title": "Source Offset",
          "type": "integer"
        },
        "source_partition": {
          "minimum": 0,
          "title": "Source Partition",
          "type": "integer"
        },
        "source_topic": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Topic",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_type",
        "event_id",
        "correlation_id",
        "attempt",
        "emitted_at",
        "source_topic",
        "source_partition",
        "source_offset",
        "consumer_group",
        "expected_event_type",
        "attempts",
        "error",
        "original_value"
      ],
      "title": "DeadLetterEvent",
      "type": "object"
    },
    "StatusEvent": {
      "additionalProperties": true,
      "properties": {
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "event_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "status",
          "title": "Event Type",
          "type": "string"
        },
        "log": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log"
        },
        "organization_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "service": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "stage_run_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Run Id"
        },
        "status": {
          "enum": [
            "processing",
            "success",
            "error",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "vol_id": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$",
          "title": "Vol Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_type",
        "event_id",
        "correlation_id",
        "attempt",
        "emitted_at",
        "vol_id",
        "status"
      ],
      "title": "StatusEvent",
      "type": "object"
    }
  },
  "$id": "urn:droneai:kafka-events:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "control": "#/$defs/ControlEvent",
      "dead_letter": "#/$defs/DeadLetterEvent",
      "status": "#/$defs/StatusEvent"
    },
    "propertyName": "event_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StatusEvent"
    },
    {
      "$ref": "#/$defs/ControlEvent"
    },
    {
      "$ref": "#/$defs/DeadLetterEvent"
    }
  ],
  "title": "DroneAI Kafka Event v1"
}
