# ============================================================
# Stage 1: Build COLMAP + Ceres from source (devel image)
# ============================================================
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build git build-essential \
    libboost-program-options-dev libboost-filesystem-dev libboost-graph-dev \
    libboost-system-dev libboost-iostreams-dev libgoogle-glog-dev libgflags-dev \
    libsuitesparse-dev \
    libatlas-base-dev libeigen3-dev liblz4-dev libmetis-dev \
    libopencv-dev libopenblas-dev libpng-dev libjpeg-dev libtiff-dev \
    libopenimageio-dev openimageio-tools libopenexr-dev libsqlite3-dev libflann-dev libssl-dev \
    libcudnn9-dev-cuda-12 libcudss0-dev-cuda-12 libcudss0-static-cuda-12 \
    libopengl-dev libglew-dev \
    && rm -rf /var/lib/apt/lists/*

# Ceres Solver 2.3.0 (master) with CUDA + cuDSS (cloned by setup_deps.sh)
# cuDSS support requires Ceres >= 2.3.0 — 2.2.0 silently ignores USE_CUDSS
COPY app1-colmap/ceres-solver /tmp/ceres-solver
# Fix cuDSS header lookup: cmake config expects headers relative to its own dir
RUN ln -sf /usr/include/libcudss/12 /usr/lib/x86_64-linux-gnu/libcudss/12/include
# Configure Ceres
RUN cd /tmp/ceres-solver && mkdir build && cd build && \
    cmake .. -GNinja \
        -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF \
        -DUSE_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES="86-real;89-real" \
        -Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss \
        -Dcudss_INCLUDE_DIR=/usr/include/libcudss/12 \
        -DCMAKE_PREFIX_PATH=/usr/lib/x86_64-linux-gnu/libcudss/12
# Build and install Ceres
RUN cd /tmp/ceres-solver/build && ninja install
# Verify cuDSS + CUDA support is compiled in
# In config.h, enabled features have their #define commented out (// #define CERES_NO_X)
# A disabled feature has an uncommented #define CERES_NO_X
RUN set -e; \
    config=/usr/local/include/ceres/internal/config.h; \
    if grep -qP '^#define CERES_NO_CUDSS\b' "$config"; then \
        echo 'ERROR: Ceres was installed without cuDSS support!' >&2; exit 1; \
    fi; \
    if grep -qP '^#define CERES_NO_CUDA\b' "$config"; then \
        echo 'ERROR: Ceres was installed without CUDA support!' >&2; exit 1; \
    fi; \
    echo "Ceres cuDSS + CUDA support verified OK"; \
    rm -rf /tmp/ceres-solver

# COLMAP 4.0.1 (cloned by setup_deps.sh)
# Pre-downloaded FetchContent deps avoid network calls during cmake
COPY app1-colmap/colmap-deps /tmp/colmap-deps
COPY app1-colmap/colmap-local /tmp/colmap
RUN cd /tmp/colmap \
    && sed -i 's|URL https://github.com/PoseLib/PoseLib/archive/[^ ]*|URL file:///tmp/colmap-deps/poselib.zip|' src/thirdparty/CMakeLists.txt \
    && sed -i 's|URL https://github.com/ahojnnes/faiss/archive/[^ ]*|URL file:///tmp/colmap-deps/faiss.zip|' src/thirdparty/CMakeLists.txt \
    && rm -rf build && mkdir build && cd build \
    && cmake .. -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCOLMAP_MINIMAL_PIPELINE_BUILD=ON \
        -DCUDA_ENABLED=ON \
        -DONNX_ENABLED=OFF \
        -DLSD_ENABLED=OFF \
        -DCGAL_ENABLED=OFF \
        -DIPO_ENABLED=OFF \
        -DOPENGL_ENABLED=OFF \
        -DCMAKE_CUDA_ARCHITECTURES="86-real;89-real" \
        -Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss \
        -Dcudss_INCLUDE_DIR=/usr/include/libcudss/12 \
    && ninja install \
    && rm -rf /tmp/colmap /tmp/colmap-deps

# Stage only the CUDA runtime .so files that COLMAP + Ceres actually link against.
# Avoids pulling the full 2.6 GB CUDA runtime suite into the final image.
# libnvJitLink is a transitive dep of COLMAP and libcusparse (JIT compilation of GPU kernels).
RUN mkdir -p /cuda-slim && cd /usr/local/cuda/lib64 && \
    cp -a libcublas.so* libcublasLt.so* \
          libcusparse.so* libcusolver.so* \
          libcurand.so* libnvJitLink.so* libnvrtc.so* libnvrtc-builtins.so* /cuda-slim/ && \
    rm -f /cuda-slim/libcusolverMg* /cuda-slim/*.a && \
    find /usr/lib/x86_64-linux-gnu -maxdepth 1 -name 'libcudss.so*' -exec cp -a {} /cuda-slim/ \; && \
    find /usr/lib/x86_64-linux-gnu/libcudss -name 'libcudss.so*' -exec cp -a {} /cuda-slim/ \; 2>/dev/null; \
    ls -lh /cuda-slim/

# ============================================================
# Stage 2: Build Python packages that need nvcc (devel image)
# ============================================================
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS pip-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-setuptools python3-dev \
    git build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Pure Python packages
RUN pip3 install --no-cache-dir --break-system-packages \
    confluent-kafka rasterio numpy plyfile pyproj Pillow pycolmap==4.0.1 scipy \
    boto3 sqlalchemy geoalchemy2 psycopg2-binary alembic

# CuPy (replaces PyTorch + gsplat — custom CUDA rasteriser uses CuPy RawKernels)
RUN pip3 install --no-cache-dir --break-system-packages cupy-cuda12x

# ============================================================
# Stage 3: Build LichtFeld-Studio from source
# Needs gcc-14 + cmake 4.x + vcpkg — separate stage, parallel with 1 & 2
# ============================================================
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS lichtfeld-builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates wget unzip zip \
        pkg-config ninja-build nasm yasm \
        autoconf autoconf-archive automake libtool \
        python3 python3-dev python3-pip \
        libffi-dev libgl1-mesa-dev libegl1-mesa-dev \
    && apt-get install -y gcc-14 g++-14 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 60 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 60 \
    && update-alternatives --set gcc /usr/bin/gcc-14 \
    && update-alternatives --set g++ /usr/bin/g++-14 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) \
    && wget -q https://github.com/Kitware/CMake/releases/download/v4.0.3/cmake-4.0.3-linux-${ARCH}.sh \
    && chmod +x cmake-4.0.3-linux-${ARCH}.sh \
    && ./cmake-4.0.3-linux-${ARCH}.sh --skip-license --prefix=/usr/local \
    && rm cmake-4.0.3-linux-${ARCH}.sh

# vcpkg — COPY from host (cloned by setup_deps.sh)
COPY .docker-vcpkg/ /opt/vcpkg/
RUN /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg

# LichtFeld-Studio — COPY from host (cloned + patched by setup_deps.sh)
COPY LichtFeld-Studio/ /build/LichtFeld-Studio/
WORKDIR /build/LichtFeld-Studio

RUN git submodule update --init --recursive 2>/dev/null || true
RUN if [ ! -f external/libvterm/src/encoding.c ]; then \
        rm -rf external/libvterm && \
        git clone --depth 1 https://github.com/neovim/libvterm.git external/libvterm; \
    fi

# Strip GUI-only and optional vcpkg deps for pipeline-minimal build
# Use only core dependencies — no GUI, video, USD, mesh, SOG features
RUN python3 -c "\
import json, sys; \
m = json.load(open('vcpkg.json')); \
m['default-features'] = []; \
json.dump(m, open('vcpkg.json','w'), indent=2)"

RUN /opt/vcpkg/vcpkg install --triplet x64-linux

RUN cmake -S . -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DLFS_BUILD_PIPELINE_MINIMAL=ON \
    -DENABLE_CUDA_GL_INTEROP=OFF \
    -DBUILD_CUDA_PTX_ONLY=ON \
    -DBUILD_PYTHON_STUBS=OFF \
    -DBUILD_TESTS=OFF \
    -DENABLE_COMPILER_CACHE=OFF \
    -DCMAKE_C_COMPILER=gcc-14 \
    -DCMAKE_CXX_COMPILER=g++-14 \
    -DCMAKE_CUDA_HOST_COMPILER=g++-14 \
    -DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake

RUN cmake --build build --config ReleaseS 2>&1
RUN test -x build/LichtFeld-Studio

# Collect LichtFeld runtime files in a clean directory
RUN mkdir -p /opt/lichtfeld/lib \
    && cp build/LichtFeld-Studio /opt/lichtfeld/ \
    && cp build/liblfs_core.so build/liblfs_logger.so build/liblfs_event_bridge.so \
       build/liblfs_python_runtime.so /opt/lichtfeld/lib/ \
    && cp -a build/libnvimgcodec.so* /opt/lichtfeld/lib/ \
    && cp -r build/extensions/ /opt/lichtfeld/extensions/ \
    && cp LICENSE /opt/lichtfeld/LICENSE \
    && cp THIRD_PARTY_LICENSES.md /opt/lichtfeld/THIRD_PARTY_LICENSES.md

# ============================================================
# Stage 4: Slim runtime image (24.04 — matches all builder stages)
# ============================================================
FROM nvidia/cuda:12.8.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Runtime libraries needed by COLMAP, Ceres, and Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    curl \
    libboost-program-options1.83.0 libboost-filesystem1.83.0 libboost-graph1.83.0 \
    libboost-system1.83.0 libboost-iostreams1.83.0 \
    libgoogle-glog0v6t64 libgflags2.2 \
    libsuitesparseconfig7 libamd3 libcamd3 libccolamd3 libcolamd3 libcholmod5 \
    libcxsparse4 libspqr4 \
    libmetis5 liblz4-1 \
    libopencv-core406t64 libopencv-imgproc406t64 libopencv-imgcodecs406t64 \
    libopenblas0 libatlas3-base \
    libpng16-16t64 libjpeg8 libtiff6 \
    libopenimageio2.4t64 openimageio-tools libopenexr-3-1-30 libsqlite3-0 \
    libflann1.9 libssl3t64 libxcb-cursor0 libimage-exiftool-perl \
    libgomp1 libopengl0 libglew2.2 \
    && rm -rf /var/lib/apt/lists/*

# Selective CUDA runtime libs (cuBLAS, cuSPARSE, cuSOLVER, cuDSS for COLMAP/Ceres + cuRAND for LichtFeld)
# cudart is already in cuda:base; cuDNN/cufft/npp not needed
# nvrtc is needed by nvdiffrast (LichtFeld) for runtime CUDA kernel compilation
COPY --from=builder /cuda-slim/ /usr/local/cuda/lib64/

# Copy COLMAP + Ceres installed binaries and libraries from builder
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /usr/local/lib/ /usr/local/lib/
COPY --from=builder /usr/local/share/colmap/ /usr/local/share/colmap/

# Copy all installed Python packages from pip-builder
COPY --from=pip-builder /usr/local/lib/python3.12/dist-packages/ /usr/local/lib/python3.12/dist-packages/
COPY --from=pip-builder /usr/local/bin/ /usr/local/bin/

# LichtFeld-Studio headless binary + runtime libs (GPL-3.0-or-later, subprocess only)
COPY --from=lichtfeld-builder /opt/lichtfeld/ /opt/lichtfeld/
ENV LD_LIBRARY_PATH="/opt/lichtfeld/lib:${LD_LIBRARY_PATH}"
ENV LICHTFELD_BIN="/opt/lichtfeld/LichtFeld-Studio"

RUN ldconfig
