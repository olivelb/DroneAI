FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TORCH_CUDA_ARCH_LIST="8.6;8.9"
WORKDIR /app

# --- LAYER 1: Base Stable Dependencies ---
RUN apt-get update && apt-get install -y \
    cmake ninja-build git build-essential \
    libboost-program-options-dev libboost-filesystem-dev libboost-graph-dev \
    libboost-system-dev libboost-iostreams-dev libgoogle-glog-dev libgflags-dev \
    libsuitesparse-dev libfreeimage-dev libglew-dev libqt5opengl5-dev qtbase5-dev \
    libcgal-dev libatlas-base-dev libeigen3-dev libgmp-dev liblz4-dev libmetis-dev \
    libopencv-dev libopenblas-dev libpng-dev libjpeg-dev libtiff-dev \
    libcudnn9-dev-cuda-12 libcudss0-dev-cuda-12 \
    python3 python3-pip python3-setuptools curl \
    && rm -rf /var/lib/apt/lists/*

# --- LAYER 2: Ceres Solver (Stable) ---
RUN set -eux; \
    git clone https://github.com/ceres-solver/ceres-solver.git; \
    cd ceres-solver; \
    git checkout 2.2.0; \
    mkdir build; \
    cd build; \
    cmake .. -GNinja \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DUSE_CUDA=ON \
        -DUSE_CUDSS=ON \
        -Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss \
        -DCMAKE_PREFIX_PATH=/usr/lib/x86_64-linux-gnu/libcudss/12 \
        2>&1 | tee /tmp/ceres-cmake.log; \
    echo '---- Ceres CUDA/cuDSS configure summary ----'; \
    grep -Ei 'cuda|cudss|suitesparse|sparse' /tmp/ceres-cmake.log || true; \
    ninja install; \
    test -f /usr/local/include/ceres/internal/config.h; \
    echo '---- Installed Ceres config header flags ----'; \
    grep -E '^#define CERES_(NO_CUDA|NO_CUDSS)' /usr/local/include/ceres/internal/config.h || true; \
    if grep -q '^#define CERES_NO_CUDA' /usr/local/include/ceres/internal/config.h \
        || grep -q '^#define CERES_NO_CUDSS' /usr/local/include/ceres/internal/config.h; then \
        echo 'Ceres was installed without the required CUDA/cuDSS support.' >&2; \
        exit 1; \
    fi; \
    cd ../..; \
    rm -rf ceres-solver /tmp/ceres-cmake.log

# --- LAYER 3: Additional Dependencies ---
RUN apt-get update && apt-get install -y \
    libopenimageio-dev openimageio-tools libopenexr-dev libsqlite3-dev \
    libflann-dev libssl-dev libxcb-cursor0 libimage-exiftool-perl \
    && rm -rf /var/lib/apt/lists/*

# --- LAYER 4: COLMAP 4.0.1 ---
RUN git clone https://github.com/colmap/colmap.git \
    && cd colmap && git checkout 4.0.1 \
    && mkdir build && cd build \
    && cmake .. -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DGUI=OFF \
        -DCUDA_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES="86-real;89-real" \
    && ninja install \
    && cd ../.. && rm -rf colmap

# --- LAYER 5: Python Dependencies ---
RUN pip3 install --no-cache-dir \
    confluent-kafka exif rasterio numpy plyfile pyproj trimesh Pillow pycolmap==4.0.1 scipy

RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 torch torchvision \
    && pip3 install --no-cache-dir --no-build-isolation git+https://github.com/NVlabs/nvdiffrast.git \
    && pip3 install --no-cache-dir gsplat==1.5.3
