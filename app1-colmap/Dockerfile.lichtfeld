# Multi-stage build for the pipeline-minimal LichtFeld headless trainer.
#
# Usage:
#   docker build --network=host -t lichtfeld-runtime:latest -f app1-colmap/Dockerfile.lichtfeld .
#
# The final image is NOT run standalone — it's used as a COPY source
# in the main app1-colmap Dockerfile.
#
# License: LichtFeld-Studio is GPL-3.0-or-later. We invoke it as a subprocess
# (no linking), and include the license text as required.

# ============================================================
# Stage 1: Build LichtFeld-Studio from source
# ============================================================
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

# Build tools + system libs needed by the minimal vcpkg ports
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates wget unzip zip \
        pkg-config ninja-build nasm yasm \
        autoconf autoconf-archive automake libtool \
        python3 python3-dev python3-pip \
        libffi-dev libgl1-mesa-dev libegl1-mesa-dev \
    && apt-get install -y gcc-14 g++-14 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 60 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 60 \
    && update-alternatives --set gcc /usr/bin/gcc-14 \
    && update-alternatives --set g++ /usr/bin/g++-14 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# CMake 4.x (required >= 3.30)
RUN ARCH=$(uname -m) \
    && wget -q https://github.com/Kitware/CMake/releases/download/v4.0.3/cmake-4.0.3-linux-${ARCH}.sh \
    && chmod +x cmake-4.0.3-linux-${ARCH}.sh \
    && ./cmake-4.0.3-linux-${ARCH}.sh --skip-license --prefix=/usr/local \
    && rm cmake-4.0.3-linux-${ARCH}.sh

# vcpkg — copy pre-cloned repo from host (already at baseline commit).
# Avoids network-dependent git clone during build.
# To regenerate: see comments in build_and_deploy.sh or run:
#   git clone --no-checkout /path/to/vcpkg .docker-vcpkg && \
#   git -C .docker-vcpkg checkout c3867e714dd3a51c272826eea77267876517ed99
COPY .docker-vcpkg/ /opt/vcpkg/
RUN /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg

# Copy LichtFeld source
COPY LichtFeld-Studio/ /build/LichtFeld-Studio/
WORKDIR /build/LichtFeld-Studio

# Clean any stale host build artefacts (CMakeCache.txt paths won't match)
RUN rm -rf build

# The repository patch removes GUI, USD, mesh, video, and SOG requirements.
RUN python3 -c "\
import json; \
manifest = json.load(open('vcpkg.json')); \
manifest['default-features'] = []; \
json.dump(manifest, open('vcpkg.json', 'w'), indent=2)"

# Pre-install vcpkg dependencies (sources are pre-downloaded in .docker-vcpkg/downloads/).
RUN /opt/vcpkg/vcpkg install --triplet x64-linux

# Configure — PTX-only for smaller binary with JIT at runtime
RUN cmake -S . -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DLFS_BUILD_PIPELINE_MINIMAL=ON \
    -DENABLE_CUDA_GL_INTEROP=OFF \
    -DBUILD_CUDA_PTX_ONLY=ON \
    -DBUILD_PYTHON_STUBS=OFF \
    -DBUILD_TESTS=OFF \
    -DENABLE_COMPILER_CACHE=OFF \
    -DCMAKE_C_COMPILER=gcc-14 \
    -DCMAKE_CXX_COMPILER=g++-14 \
    -DCMAKE_CUDA_HOST_COMPILER=g++-14 \
    -DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake

# Build
RUN cmake --build build --config Release -j$(nproc)

# Verify
RUN test -x build/LichtFeld-Studio

# ============================================================
# Stage 2: Slim runtime image with just the binary + libs
# ============================================================
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 libgomp1 libcap2 liblz4-1 liblzma5 libzstd1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create LichtFeld directory
RUN mkdir -p /opt/lichtfeld/lib

# Copy binary
COPY --from=builder /build/LichtFeld-Studio/build/LichtFeld-Studio /opt/lichtfeld/

# Copy the pipeline-minimal LFS shared libraries
COPY --from=builder /build/LichtFeld-Studio/build/liblfs_core.so /opt/lichtfeld/lib/
COPY --from=builder /build/LichtFeld-Studio/build/liblfs_logger.so /opt/lichtfeld/lib/
COPY --from=builder /build/LichtFeld-Studio/build/liblfs_event_bridge.so /opt/lichtfeld/lib/
COPY --from=builder /build/LichtFeld-Studio/build/liblfs_python_runtime.so /opt/lichtfeld/lib/

# Copy nvImageCodec
COPY --from=builder /build/LichtFeld-Studio/build/libnvimgcodec.so* /opt/lichtfeld/lib/

# Python runtime extensions are still required by the headless application.
COPY --from=builder /build/LichtFeld-Studio/build/extensions/ /opt/lichtfeld/extensions/

# Copy GPL-3.0 license (required by license terms)
COPY --from=builder /build/LichtFeld-Studio/LICENSE /opt/lichtfeld/LICENSE
COPY --from=builder /build/LichtFeld-Studio/THIRD_PARTY_LICENSES.md /opt/lichtfeld/THIRD_PARTY_LICENSES.md

# Set up library path
ENV LD_LIBRARY_PATH="/opt/lichtfeld/lib:${LD_LIBRARY_PATH}"
ENV LICHTFELD_BIN="/opt/lichtfeld/LichtFeld-Studio"

# Verify the binary runs
RUN /opt/lichtfeld/LichtFeld-Studio --version || true

LABEL description="LichtFeld-Studio headless runtime for Gaussian splatting training"
LABEL license="GPL-3.0-or-later"
